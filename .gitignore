# 运行时临时数据（可重新生成）
# 注意：这里刻意不整目录忽略 temp/ —— temp/music/ 是正式内容
# （_MUSIC_DIR 的 BGM 库，/api/video/music-list 在服务它）。新加规则时同样别盖住它。
temp/scraped_images/
temp/backups/
temp/video_set/
# *.bak*（非 *.bak.*）：库备份叫 app.db.bak-before-*，原模式匹配不到
temp/*.bak*
temp/server.*
temp/*.db-shm
temp/*.db-wal
temp/*.db
temp/app.db
temp/audio_replace
# 调试/审查草稿（2026-09-25 被 git add -A 误扫进索引 168 个文件，事后补的规则）
temp/_*
temp/mut-backup/
temp/dist-backup-*/
temp/deleted-*.csv

# 配置敏感信息（含密码）
config/config.local.json

# Google Sheets 凭据
config/google_sheets_credentials.json
config/google_sheets_token.json
